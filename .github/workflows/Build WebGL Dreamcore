name: Build WebGL Dreamcore

on:
  push:
    branches: [ main ]

jobs:
  webgl-build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Unzip MVP ZIP
        run: unzip Dreamcore_Unity_MVP_codebase.zip -d Dreamcore_Unity_MVP

      - name: Setup Unity
        uses: game-ci/unity-builder@v2
        with:
          unityVersion: 2021.3.60f1
          targetPlatform: WebGL
          projectPath: Dreamcore_Unity_MVP

      - name: Build WebGL
        run: |
          echo "WebGL 빌드 시작..."
          # Unity Builder가 실제 빌드를 수행합니다. 필요시 추가 파라미터 설정

      - name: Upload WebGL artifact
        uses: actions/upload-artifact@v3
        with:
          name: Dreamcore-WebGL
          path: Dreamcore_Unity_MVP/builds/webgl
